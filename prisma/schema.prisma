generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL") // URL do MongoDB definida no .env
}

model Usuarios {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  nome        String
  email       String   @unique
  senha       String
  status      Boolean
  dataCriacao DateTime
  tipoUsuario Int

  lojas UsuarioLoja[] // Relacionamento muitos-para-muitos via tabela de junção
}

model Lojas {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  nome        String
  cep         String
  logradouro  String
  numero      Int
  bairro      String
  cidade      String
  uf          String
  cnpj        String
  telefone    String
  email       String
  status      Boolean
  dataCriacao DateTime

  usuarios UsuarioLoja[] // Relacionamento muitos-para-muitos via tabela de junção
}

// Tabela de junção para o relacionamento muitos-para-muitos
model UsuarioLoja {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  usuarioId String @db.ObjectId
  lojaId    String @db.ObjectId

  usuario Usuarios @relation(fields: [usuarioId], references: [id])
  loja    Lojas    @relation(fields: [lojaId], references: [id])

  @@unique([usuarioId, lojaId]) // Garante que cada par usuário-loja seja único
}