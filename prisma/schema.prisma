generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL") // URL do MongoDB definida no .env
}

model Usuarios {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  nome        String
  email       String      @unique
  senha       String
  status      Boolean
  dataCriacao DateTime
  tipoUsuario Int

  lojas Lojas[] // Relacionamento com várias lojas
}

model Lojas {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  nome        String
  endereco    String
  numero      String
  cnpj        String
  telefone    String
  email       String
  status      Boolean
  dataCriacao DateTime

  usuarioId String   @db.ObjectId // Removido o @unique para permitir várias lojas por usuário
  usuario   Usuarios @relation(fields: [usuarioId], references: [id]) // Relacionamento com usuário
}

